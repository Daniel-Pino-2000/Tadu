# Normalize line endings so the project builds consistently across Windows,
# macOS and Linux.
* text=auto eol=lf

# Gradle wrapper and scripts
gradlew text eol=lf
gradlew.bat text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.aab binary
*.apk binary
*.keystore binary
*.jks binary

# Keep generated docs out of language statistics
screenshots/** linguist-documentation
